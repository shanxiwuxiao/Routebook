```bash
# ---- 应用 ----
ENV=development                          # development | production
DEBUG=true
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---- 数据库 ----
DATABASE_URL=postgresql+asyncpg://routebook:routebook@localhost:5432/routebook
DATABASE_URL_SYNC=postgresql+psycopg://routebook:routebook@localhost:5432/routebook
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- RabbitMQ / Celery ----
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_TASK_ALWAYS_EAGER=false           # 测试时设 true，任务同步执行

# ---- LLM ----
LLM_PROVIDER=openai                      # openai | deepseek | dashscope | zhipu | ollama | fake
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
AI_NEXT_STEP_TIMEOUT_SECONDS=5           # 下一步建议的超时，超了就降级
AI_NEXT_STEP_ENABLED=true                # 可一键关闭 AI，走纯规则

# ---- Embedding ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                       # ⚠️ 换模型必须同步改 chunks.embedding的维度

# ---- 限流 ----
RATE_LIMIT_ENABLED=true

# ---- 成本计算（用于统计展示）----
LLM_PRICE_INPUT_PER_1M=0.15
LLM_PRICE_OUTPUT_PER_1M=0.60